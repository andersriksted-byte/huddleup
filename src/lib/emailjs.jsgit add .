// ── EmailJS: sender "inviter en ny spiller"-mails fra klienten uden en backend. ──────────
//
// Firebase Auth klarer selv login-, signup- og glemt-adgangskode-mails (sendPasswordResetEmail).
// Men "inviter en spiller der ikke har en konto endnu" er en helt almindelig e-mail med et
// signup-link, og det har Firebase Auth ingen indbygget skabelon til. EmailJS er valgt til
// netop den mail, fordi den:
//   • kører 100% fra browseren (ingen server, ingen Cloud Functions, ingen Blaze-plan/kreditkort)
//   • har et gratis niveau (ca. 200 mails/måned), som rigeligt dækker holdinvitationer
//   • er den eneste af de to muligheder, der virker uændret fra statisk GitHub Pages-hosting
//
// Opsætning (gratis, ingen kreditkort):
//   1. Opret en konto på https://www.emailjs.com
//   2. Tilføj en "Email Service" (fx Gmail) under Email Services — noter dens Service ID
//   3. Opret en Email Template under Email Templates med felterne herunder — noter dens Template ID
//      Skabelon-variabler du kan bruge i templaten: {{to_email}} {{to_name}} {{from_name}}
//      {{invitation_title}} {{signup_url}}
//   4. Find din Public Key under Account → General
//   5. Udfyld de tre værdier herunder
//
// Indtil du udfylder dem, virker resten af appen fint — "Inviter en ny spiller" vil blot vise
// en fejlbesked i stedet for at sende en mail.

const EMAILJS_SERVICE_ID = "service_8ojqjuw";
const EMAILJS_TEMPLATE_ID = "template_4o94vdk";
const EMAILJS_PUBLIC_KEY = "NM5GqeO0ak9DJzAW2";

const isConfigured = () =>
  EMAILJS_SERVICE_ID !== "REPLACE_WITH_YOUR_EMAILJS_SERVICE_ID" &&
  EMAILJS_TEMPLATE_ID !== "REPLACE_WITH_YOUR_EMAILJS_TEMPLATE_ID" &&
  EMAILJS_PUBLIC_KEY !== "REPLACE_WITH_YOUR_EMAILJS_PUBLIC_KEY";

let emailjsLib = null;
async function getEmailJs() {
  if (!emailjsLib) {
    // Lazy-loadet, så resten af appen ikke kræver pakken for at bygge/køre.
    emailjsLib = await import("@emailjs/browser");
  }
  return emailjsLib;
}

// Sender en invitationsmail til en spiller der endnu ikke har en konto.
// Kaster en fejl hvis EmailJS ikke er konfigureret endnu — fang den i UI'et og vis en besked.
export async function sendInviteEmail({ toEmail, toName, fromName, invitationTitle, signupUrl }) {
  if (!isConfigured()) {
    throw new Error(
      "EmailJS er ikke sat op endnu. Udfyld EMAILJS_SERVICE_ID / TEMPLATE_ID / PUBLIC_KEY i src/lib/emailjs.js."
    );
  }
  const { default: emailjs } = await getEmailJs();
  await emailjs.send(
    EMAILJS_SERVICE_ID,
    EMAILJS_TEMPLATE_ID,
    {
      to_email: toEmail,
      to_name: toName || toEmail,
      from_name: fromName || "En holdkammerat",
      invitation_title: invitationTitle || "",
      signup_url: signupUrl,
    },
    { publicKey: EMAILJS_PUBLIC_KEY }
  );
}

export { isConfigured as isEmailJsConfigured };
